{
  "name": "arturia",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "scripts": {
    "start": "ng serve",
    "start:fixtures": "ng serve --configuration fixtures",
    "build": "ng build --configuration production --stats-json && node scripts/prepare-theme.mjs && node scripts/check-production.mjs",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/check-contract.mjs && node scripts/generate-contract.mjs --check",
    "test:contract": "node --test scripts/check-contract.test.mjs",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:cross": "ARTURIA_CROSS_BROWSER=1 playwright test",
    "test:e2e:aws": "playwright test --config playwright.aws.config.ts",
    "test:e2e:aws:unit": "node --test \"tests/e2e-aws/*.test.ts\"",
    "verify": "npm run test:contract && npm run contract:check && npm run test:e2e:aws:unit && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@axe-core/playwright": "4.14.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.5",
    "jsdom": "31.0.1",
    "json-schema-to-typescript": "16.0.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    },
    "@apidevtools/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}
